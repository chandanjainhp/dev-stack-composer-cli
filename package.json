{
  "name": "@devstackcomposer/mern-ai",
  "version": "1.0.0",
  "description": "AI-powered MERN stack project generator CLI for Dev Stack Composer",
  "main": "lib/index.js",
  "bin": {
    "mern-ai": "bin/mern-ai.js"
  },
  "scripts": {
    "start": "node bin/mern-ai.js",
    "test": "mocha tests/**/*.test.js",
    "test:integration": "mocha tests/integration/**/*.test.js",
    "test:e2e": "mocha tests/e2e/**/*.test.js",
    "coverage": "nyc npm test",
    "lint": "eslint lib tests",
    "dev": "nodemon bin/mern-ai.js",
    "build": "echo 'No build step required'",
    "prepublishOnly": "npm test"
  },
  "keywords": [
    "mern",
    "cli",
    "generator",
    "ai",
    "react",
    "express",
    "mongodb",
    "nodejs",
    "dev-stack-composer"
  ],
  "author": "Chandan Jain <chandan@devstackcomposer.com>",
  "license": "MIT",
  "dependencies": {
    "commander": "^11.0.0",
    "chalk": "^4.1.2",
    "ora": "^5.4.1",
    "figlet": "^1.6.0",
    "axios": "^1.6.0",
    "fs-extra": "^11.0.0",
    "handlebars": "^4.7.8",
    "joi": "^17.11.0",
    "glob": "^10.3.0",
    "which": "^4.0.0",
    "inquirer": "^8.2.6",
    "boxen": "^5.1.2",
    "update-notifier": "^6.0.2",
    "semver": "^7.5.4",
    "node-fetch": "^3.3.2",
    "dotenv": "^16.3.1",
    "yaml": "^2.3.4"
  },
  "devDependencies": {
    "mocha": "^10.2.0",
    "chai": "^4.3.8",
    "nyc": "^15.1.0",
    "eslint": "^8.50.0",
    "nodemon": "^3.0.1",
    "sinon": "^16.0.0"
  },
  "engines": {
    "node": ">=16.0.0"
  },
  "os": ["darwin", "linux", "win32"],
  "repository": {
    "type": "git",
    "url": "https://github.com/chandanjainhp/dev-stack-composer.git",
    "directory": "cli"
  },
  "bugs": {
    "url": "https://github.com/chandanjainhp/dev-stack-composer/issues"
  },
  "homepage": "https://github.com/chandanjainhp/dev-stack-composer/tree/main/cli#readme"
